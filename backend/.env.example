# ============================================================
# SCHOOLOS BACKEND ENVIRONMENT CONFIGURATION
# ============================================================

# App
NODE_ENV=development
PORT=5000
LOG_LEVEL=debug
REQUEST_TIMEOUT_MS=15000
RATE_LIMIT_ENABLED=true
# Comma-separated browser origins. Required when NODE_ENV=production.
CORS_ORIGINS=http://localhost:5173
# Keep request bodies bounded. Uploads should go directly to Cloudinary.
JSON_BODY_LIMIT=1mb
FORM_BODY_LIMIT=1mb

# Auth
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRY=7d
# Demo/development only. Keep false in production unless the environment is
# intentionally a non-production showcase with disposable accounts.
ENABLE_INSTANT_LOGIN=true

# Communication jobs and optional delivery providers. External channels remain
# SKIPPED (never falsely successful) until a real adapter is configured.
COMMUNICATION_JOBS_ENABLED=true
COMMUNICATION_JOB_INTERVAL_MS=60000
EMAIL_PROVIDER=
SMS_PROVIDER=
PUSH_PROVIDER=
WHATSAPP_PROVIDER=

# Cloudinary (required for gallery and school branding uploads)
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET="your_api_secret"

# ============================================================
# DB CONNECTION MODE
# Allowed: pooler | direct | supabase
# ============================================================
DB_CONNECTION_MODE=pooler

# ============================================================
# METHOD 1: SESSION POOLER (RECOMMENDED)
# Supabase Dashboard -> Connect -> Session pooler
# Use this IPv4-compatible connection on Render.
# ============================================================
MASTER_DB_HOST=aws-0-your-region.pooler.supabase.com
MASTER_DB_PORT=5432
MASTER_DB_USER=postgres.your-project-ref
MASTER_DB_PASSWORD=your_db_password
MASTER_DB_NAME=postgres

# Prisma reads DATABASE_URL directly. Copy the complete Session pooler URL from
# Supabase Connect and URL-encode special characters in the password.
DATABASE_URL=postgresql://postgres.your-project-ref:your_url_encoded_password@aws-0-your-region.pooler.supabase.com:5432/postgres?sslmode=require
DIRECT_URL=

# Cache: memory is zero-dependency for local/single-instance use. Use redis for
# multiple production instances. Redis failures fall back to bounded memory.
CACHE_ENABLED=true
CACHE_PROVIDER=memory
CACHE_DEFAULT_TTL=300
CACHE_MAX_ENTRIES=1000
REDIS_URL=

# Separate secrets are recommended in production. JWT_SECRET remains supported
# for backward compatibility during migration.
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=
CSRF_SECRET=

# ============================================================
# METHOD 2: DIRECT POSTGRESQL
# Supabase Dashboard -> Settings -> Database -> Direct connection
# ============================================================
# MASTER_DB_HOST=db.your-project-ref.supabase.co
# MASTER_DB_PORT=5432
# MASTER_DB_USER=postgres
# MASTER_DB_PASSWORD=your_db_password
# MASTER_DB_NAME=postgres

# ============================================================
# METHOD 3: SUPABASE API CLIENT (@supabase/supabase-js)
# ============================================================
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_ANON_KEY=your_anon_public_key


