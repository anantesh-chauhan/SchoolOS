// public platform domain

model GalleryGroup {
  id            String   @id @default(uuid())
  schoolId      String
  title         String
  description   String?
  coverImageUrl String?
  isVisible     Boolean  @default(true)
  displayOrder  Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  school School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  photos GalleryPhoto[]

  @@unique([schoolId, title])
  @@index([schoolId, isVisible, displayOrder])
  @@index([schoolId, createdAt])
}

model GalleryPhoto {
  id           String   @id @default(uuid())
  schoolId     String
  groupId      String
  imageUrl     String
  caption      String?
  isVisible    Boolean  @default(true)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())

  school School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  group  GalleryGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([schoolId, groupId, isVisible, displayOrder])
  @@index([groupId, displayOrder])
}

model SchoolSettings {
  id             String   @id @default(uuid())
  schoolId       String   @unique
  schoolName     String
  logoUrl        String?
  email          String?
  phone          String?
  addressLine1   String?
  addressLine2   String?
  city           String?
  state          String?
  country        String?
  postalCode     String?
  website        String?
  supportEmail   String?
  primaryColor   String   @default("#0f766e")
  secondaryColor String   @default("#0f172a")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
}
