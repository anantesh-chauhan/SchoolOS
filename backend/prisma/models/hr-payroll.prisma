// hr payroll domain

model Employee {
  id                String                     @id @default(cuid())
  schoolId          String
  userId            String?
  teacherId         String?                    @unique
  employeeId        String
  firstName         String
  lastName          String?
  gender            String?
  dateOfBirth       DateTime?
  bloodGroup        String?
  mobile            String
  email             String?
  aadhaarMasked     String?
  panMasked         String?
  address           String?
  department        String
  designation       String
  category          EmployeeCategory
  employmentType    EmploymentType             @default(PERMANENT)
  status            EmploymentStatus           @default(ACTIVE)
  joiningDate       DateTime
  exitDate          DateTime?
  bankName          String?
  bankAccountMasked String?
  ifsc              String?
  emergencyContact  Json?
  qualifications    Json?
  experience        Json?
  profileImageUrl   String?
  metadata          Json?
  deletedAt         DateTime?
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt
  school            School                     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  teacher           Teacher?                   @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  documents         EmployeeDocument[]
  salaryRevisions   EmployeeSalaryRevision[]
  attendances       EmployeeAttendance[]
  leaveApplications EmployeeLeaveApplication[]
  leaveBalances     EmployeeLeaveBalance[]
  payrolls          EmployeePayroll[]

  @@unique([schoolId, employeeId])
  @@index([schoolId, status, deletedAt])
  @@index([schoolId, department, designation])
  @@index([schoolId, category])
  @@index([schoolId, mobile])
  @@index([userId])
}

model EmployeeDocument {
  id         String    @id @default(cuid())
  employeeId String
  type       String
  name       String
  url        String
  expiresAt  DateTime?
  verifiedAt DateTime?
  metadata   Json?
  createdAt  DateTime  @default(now())
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, type])
  @@index([expiresAt])
}

model EmployeeSalaryRevision {
  id            String    @id @default(cuid())
  employeeId    String
  monthlyGross  Decimal   @db.Decimal(14, 2)
  basicSalary   Decimal   @db.Decimal(14, 2)
  components    Json?
  effectiveFrom DateTime
  effectiveTo   DateTime?
  reason        String?
  approvedById  String?
  createdAt     DateTime  @default(now())
  employee      Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, effectiveFrom])
  @@index([employeeId, effectiveFrom, effectiveTo])
}

model HrLeavePolicy {
  id                String   @id @default(cuid())
  schoolId          String   @unique
  annualLeaveCount  Decimal  @default(15) @db.Decimal(6, 2)
  monthlyPaidLimit  Decimal  @default(2) @db.Decimal(6, 2)
  carryForward      Boolean  @default(true)
  maxCarryForward   Decimal? @db.Decimal(6, 2)
  leaveExpiryMonth  Int?
  lateEntriesPerDay Int?
  includeWeeklyOff  Boolean  @default(false)
  rules             Json?
  updatedById       String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  school            School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
}

model EmployeeLeaveBalance {
  id         String    @id @default(cuid())
  employeeId String
  leaveYear  Int
  opening    Decimal   @default(0) @db.Decimal(6, 2)
  accrued    Decimal   @default(15) @db.Decimal(6, 2)
  used       Decimal   @default(0) @db.Decimal(6, 2)
  adjusted   Decimal   @default(0) @db.Decimal(6, 2)
  expiresAt  DateTime?
  updatedAt  DateTime  @updatedAt
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, leaveYear])
  @@index([leaveYear])
}

model EmployeeLeaveApplication {
  id            String             @id @default(cuid())
  schoolId      String
  employeeId    String
  leaveType     EmployeeLeaveType
  startDate     DateTime
  endDate       DateTime
  days          Decimal            @db.Decimal(6, 2)
  reason        String
  attachmentUrl String?
  status        LeaveRequestStatus @default(PENDING)
  reviewedById  String?
  reviewedAt    DateTime?
  reviewComment String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  school        School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  employee      Employee           @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([schoolId, status, startDate])
  @@index([schoolId, employeeId, startDate])
}

model EmployeeAttendance {
  id               String             @id @default(cuid())
  schoolId         String
  employeeId       String
  attendanceDate   DateTime
  status           String             @default("PRESENT")
  source           AttendanceSource   @default(MANUAL)
  checkIn          DateTime?
  checkOut         DateTime?
  minutesLate      Int                @default(0)
  minutesEarlyExit Int                @default(0)
  remarks          String?
  sourceReference  String?
  markedById       String?
  attendanceUnits  Decimal            @default(1) @db.Decimal(4, 2)
  salaryImpactDays Decimal            @default(0) @db.Decimal(5, 2)
  approvalStatus   LeaveRequestStatus @default(APPROVED)
  leaveReference   String?
  lockedAt         DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  school           School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  employee         Employee           @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([schoolId, employeeId, attendanceDate])
  @@index([schoolId, attendanceDate, status])
  @@index([schoolId, employeeId, attendanceDate])
  @@index([source, sourceReference])
  @@index([schoolId, attendanceDate, salaryImpactDays])
}

model EmployeePayroll {
  id                   String        @id @default(cuid())
  schoolId             String
  employeeId           String
  payrollMonth         DateTime
  workingDays          Decimal       @db.Decimal(6, 2)
  payableDays          Decimal       @db.Decimal(6, 2)
  attendanceSummary    Json
  monthlyGross         Decimal       @db.Decimal(14, 2)
  basePay              Decimal       @db.Decimal(14, 2)
  allowances           Json?
  allowanceTotal       Decimal       @default(0) @db.Decimal(14, 2)
  deductions           Json?
  deductionTotal       Decimal       @default(0) @db.Decimal(14, 2)
  netSalary            Decimal       @db.Decimal(14, 2)
  status               PayrollStatus @default(PENDING)
  lockedAt             DateTime?
  generatedById        String?
  paidAt               DateTime?
  transactionReference String?
  remarks              String?
  payslipNumber        String
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  school               School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  employee             Employee      @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@unique([schoolId, employeeId, payrollMonth])
  @@unique([schoolId, payslipNumber])
  @@index([schoolId, payrollMonth, status])
  @@index([schoolId, employeeId, payrollMonth])
}

model HrAuditLog {
  id         String   @id @default(cuid())
  schoolId   String
  actorId    String?
  actorRole  String?
  action     String
  entityType String
  entityId   String?
  oldValue   Json?
  newValue   Json?
  reason     String?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
  school     School   @relation(fields: [schoolId], references: [id], onDelete: Restrict)

  @@index([schoolId, createdAt])
  @@index([schoolId, entityType, entityId])
}
