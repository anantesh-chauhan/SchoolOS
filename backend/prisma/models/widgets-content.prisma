// widgets content domain

model UserWidgetPreference {
  id         String   @id @default(uuid())
  schoolId   String
  userId     String
  widgetKey  String
  isVisible  Boolean  @default(true)
  orderIndex Int      @default(0)
  size       String   @default("MD")
  pinned     Boolean  @default(false)
  settings   Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, widgetKey])
  @@index([schoolId, userId])
  @@index([schoolId, widgetKey])
}

model UserWidgetTodo {
  id          String         @id @default(uuid())
  schoolId    String
  userId      String
  title       String
  description String?
  dueDate     DateTime?
  priority    WidgetPriority @default(MEDIUM)
  isCompleted Boolean        @default(false)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([schoolId, userId, isCompleted])
  @@index([schoolId, dueDate])
}

model UserWidgetNote {
  id         String   @id @default(uuid())
  schoolId   String
  userId     String
  title      String
  content    String
  color      String?
  pinned     Boolean  @default(false)
  orderIndex Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([schoolId, userId, orderIndex])
}

model UserWidgetBookmark {
  id        String   @id @default(uuid())
  schoolId  String
  userId    String
  title     String
  url       String
  icon      String?
  tag       String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([schoolId, userId, isActive])
}

model UserWidgetNotification {
  id        String   @id @default(uuid())
  schoolId  String
  userId    String
  title     String
  body      String
  type      String   @default("INFO")
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([schoolId, userId, isRead])
  @@index([schoolId, createdAt])
}

model UserWidgetActivity {
  id          String   @id @default(uuid())
  schoolId    String
  userId      String
  activityKey String
  title       String
  summary     String?
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([schoolId, userId, createdAt])
  @@index([schoolId, activityKey])
}

model UserLoginStreak {
  id              String    @id @default(uuid())
  schoolId        String
  userId          String    @unique
  currentStreak   Int       @default(0)
  bestStreak      Int       @default(0)
  lastLoginAt     DateTime?
  streakStartedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([schoolId, currentStreak])
}

model SystemContent {
  id            String    @id @default(uuid())
  schoolId      String
  contentKey    String
  title         String
  body          String
  metadata      Json?
  isPublished   Boolean   @default(true)
  effectiveFrom DateTime?
  effectiveTo   DateTime?
  createdById   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  school    School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  createdBy User?  @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([schoolId, contentKey])
  @@index([schoolId, isPublished])
}
