// attendance domain

model StudentAttendance {
  id              String    @id @default(cuid())
  schoolId        String
  classId         String
  sectionId       String
  studentId       String
  attendanceDate  DateTime
  academicSession String
  status          String    @default("PRESENT")
  remarks         String?
  markedById      String?
  attendanceUnits Decimal   @default(1) @db.Decimal(4, 2)
  enrollmentId    String?
  leaveReference  String?
  submittedById   String?
  submittedAt     DateTime?
  lockedAt        DateTime?
  revision        Int       @default(1)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  school   School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  class    Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  section  Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  student  Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  markedBy User?   @relation("StudentAttendanceMarkedBy", fields: [markedById], references: [id], onDelete: SetNull)

  @@unique([schoolId, classId, sectionId, studentId, attendanceDate])
  @@index([schoolId, classId, sectionId, attendanceDate])
  @@index([schoolId, studentId, attendanceDate])
  @@index([schoolId, studentId, academicSession])
  @@index([schoolId, markedById])
  @@index([schoolId, academicSession, attendanceDate, status])
  @@index([enrollmentId, attendanceDate])
}

model TeacherAttendance {
  id              String   @id @default(cuid())
  schoolId        String
  teacherId       String
  attendanceDate  DateTime
  academicSession String
  status          String   @default("PRESENT")
  remarks         String?
  markedById      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  school   School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  teacher  Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  markedBy User?   @relation("TeacherAttendanceMarkedBy", fields: [markedById], references: [id], onDelete: SetNull)

  @@unique([schoolId, teacherId, attendanceDate])
  @@index([schoolId, attendanceDate])
  @@index([schoolId, teacherId, attendanceDate])
  @@index([schoolId, teacherId, academicSession])
  @@index([schoolId, markedById])
}

// School-wide employment records. Teaching employees can link to the existing
// Teacher model without duplicating academic assignments.

model AttendanceStatusDefinition {
  id               String   @id @default(cuid())
  schoolId         String
  code             String
  displayName      String
  shortLabel       String
  countsAsPresent  Boolean  @default(false)
  countsAsAbsent   Boolean  @default(false)
  attendanceWeight Decimal  @default(0) @db.Decimal(4, 2)
  affectsSalary    Boolean  @default(false)
  requiresApproval Boolean  @default(false)
  requiresRemark   Boolean  @default(false)
  audience         String   @default("BOTH")
  badgeStyle       String   @default("slate")
  excludedFromWork Boolean  @default(false)
  isActive         Boolean  @default(true)
  displayOrder     Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  school           School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, code])
  @@index([schoolId, audience, isActive])
}

model AttendanceRule {
  id                              String    @id @default(cuid())
  schoolId                        String    @unique
  timezone                        String    @default("Asia/Kolkata")
  academicSessionStart            DateTime?
  academicSessionEnd              DateTime?
  weeklyOffDays                   Int[]     @default([0])
  markingDeadline                 String    @default("10:30")
  attendanceOpenTime              String    @default("07:30")
  classTeacherDeadline            String    @default("09:30")
  adminAlertTime                  String    @default("09:45")
  finalSubmissionTime             String    @default("12:00")
  autoLockTime                    String    @default("23:59")
  allowBackdatedAttendance        Boolean   @default(false)
  maximumBackdatedDays            Int       @default(7)
  prohibitFutureAttendance        Boolean   @default(true)
  allowDraft                      Boolean   @default(true)
  defaultAttendanceStatus         String    @default("NOT_MARKED")
  requireAdminOverrideReason      Boolean   @default(true)
  notifyClassTeacherOnCorrection  Boolean   @default(true)
  correctionWindowHours           Int       @default(48)
  studentMinimumPercentage        Decimal   @default(75) @db.Decimal(5, 2)
  employeeMinimumPercentage       Decimal   @default(85) @db.Decimal(5, 2)
  halfDayWeight                   Decimal   @default(0.5) @db.Decimal(4, 2)
  lateWeight                      Decimal   @default(1) @db.Decimal(4, 2)
  approvedLeaveWeight             Decimal   @default(0) @db.Decimal(4, 2)
  medicalLeaveWeight              Decimal   @default(0) @db.Decimal(4, 2)
  consecutiveAbsenceAlertDays     Int       @default(3)
  parentAbsenceNotifications      Boolean   @default(true)
  studentNotifications            Boolean   @default(true)
  requiresFinalSubmission         Boolean   @default(true)
  automaticMonthEndLock           Boolean   @default(false)
  correctionsRequireAdminApproval Boolean   @default(true)
  payrollIntegrationEnabled       Boolean   @default(false)
  createdAt                       DateTime  @default(now())
  updatedAt                       DateTime  @updatedAt
  school                          School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
}

model AttendanceDailyRegister {
  id                     String               @id @default(cuid())
  schoolId               String
  academicSession        String
  classId                String
  sectionId              String
  attendanceDate         DateTime
  state                  String               @default("DRAFT")
  assignedClassTeacherId String?
  createdById            String?
  markedById             String?
  markedByRole           String?
  markedByType           String?
  overrideReasonCode     String?
  overrideReasonNote     String?
  administrativeNote     String?
  markedCount            Int                  @default(0)
  submittedById          String?
  submittedAt            DateTime?
  lockedById             String?
  lockedAt               DateTime?
  lockReason             String?
  isLocked               Boolean              @default(false)
  draftSavedAt           DateTime?
  correctedAt            DateTime?
  cancelledAt            DateTime?
  notApplicableAt        DateTime?
  currentRevisionNumber  Int                  @default(0)
  version                Int                  @default(1)
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  school                 School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  revisions              AttendanceRevision[]

  @@unique([schoolId, classId, sectionId, attendanceDate])
  @@index([schoolId, academicSession, attendanceDate, state])
  @@index([schoolId, sectionId, attendanceDate])
  @@index([schoolId, assignedClassTeacherId, attendanceDate])
  @@index([schoolId, markedById, attendanceDate])
}

model AttendanceRevision {
  id                  String   @id @default(cuid())
  schoolId            String
  attendanceSessionId String
  revisionNumber      Int
  actionType          String
  createdByUserId     String
  createdByRole       String
  reasonCode          String?
  reasonNote          String?
  summarySnapshot     Json
  recordSnapshot      Json?
  createdAt           DateTime @default(now())

  school            School                     @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  attendanceSession AttendanceDailyRegister    @relation(fields: [attendanceSessionId], references: [id], onDelete: Restrict)
  changes           AttendanceRevisionChange[]

  @@unique([attendanceSessionId, revisionNumber])
  @@index([schoolId, attendanceSessionId, revisionNumber])
  @@index([schoolId, createdAt])
}

model AttendanceRevisionChange {
  id                   String   @id @default(cuid())
  schoolId             String
  attendanceRevisionId String
  studentAttendanceId  String?
  studentId            String
  previousStatus       String?
  newStatus            String?
  previousRemark       String?
  newRemark            String?
  createdAt            DateTime @default(now())

  school             School             @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  attendanceRevision AttendanceRevision @relation(fields: [attendanceRevisionId], references: [id], onDelete: Restrict)

  @@index([schoolId, studentId, createdAt])
  @@index([attendanceRevisionId, studentId])
}

model AttendanceCorrectionRequest {
  id                   String    @id @default(cuid())
  schoolId             String
  personType           String
  personId             String
  attendanceDate       DateTime
  studentAttendanceId  String?
  employeeAttendanceId String?
  existingStatus       String
  requestedStatus      String
  reason               String
  evidenceUrl          String?
  status               String    @default("PENDING")
  requestedById        String
  reviewedById         String?
  reviewedAt           DateTime?
  reviewRemark         String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  school               School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, status, createdAt])
  @@index([schoolId, personType, personId, attendanceDate])
}

model AttendanceAuditLog {
  id                     String    @id @default(cuid())
  schoolId               String
  actorId                String?
  actorRole              String?
  action                 String
  entityType             String
  entityId               String?
  oldValue               Json?
  newValue               Json?
  reason                 String?
  approvalReference      String?
  ipAddress              String?
  userAgent              String?
  academicSessionId      String?
  attendanceSessionId    String?
  classId                String?
  sectionId              String?
  attendanceDate         DateTime?
  assignedClassTeacherId String?
  reasonCode             String?
  previousRevisionNumber Int?
  newRevisionNumber      Int?
  changedStudentCount    Int       @default(0)
  changedFields          Json?
  requestId              String?
  createdAt              DateTime  @default(now())
  school                 School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, createdAt])
  @@index([schoolId, entityType, entityId])
  @@index([schoolId, action, createdAt])
  @@index([schoolId, attendanceSessionId, createdAt])
}

model AttendanceLock {
  id                String    @id @default(cuid())
  schoolId          String
  academicSession   String
  scope             String
  scopeKey          String
  periodStart       DateTime
  periodEnd         DateTime
  lockedById        String
  lockedAt          DateTime  @default(now())
  unlockReason      String?
  approvalReference String?
  unlockedById      String?
  unlockedAt        DateTime?
  isActive          Boolean   @default(true)
  school            School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, scope, scopeKey, periodStart, periodEnd, isActive])
  @@index([schoolId, academicSession, scope, isActive])
}

model AttendanceMonthlySnapshot {
  id              String   @id @default(cuid())
  schoolId        String
  academicSession String
  subjectType     String
  subjectId       String
  month           DateTime
  summary         Json
  ruleVersion     String?
  rebuiltAt       DateTime @default(now())
  school          School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, academicSession, subjectType, subjectId, month])
  @@index([schoolId, month, subjectType])
}

model AttendanceNotificationLog {
  id             String    @id @default(cuid())
  schoolId       String
  eventType      String
  subjectType    String
  subjectId      String
  attendanceDate DateTime?
  dedupeKey      String
  recipientCount Int       @default(0)
  createdAt      DateTime  @default(now())
  school         School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, dedupeKey])
  @@index([schoolId, eventType, createdAt])
}

model SchoolWorkingDay {
  id                String   @id @default(cuid())
  schoolId          String
  academicSession   String
  calendarDate      DateTime
  calendarType      String   @default("STUDENT")
  classId           String?
  sectionId         String?
  isWorkingDay      Boolean  @default(true)
  eligibleDayWeight Decimal  @default(1) @db.Decimal(4, 2)
  reason            String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  school            School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, calendarDate, calendarType, classId, sectionId])
  @@index([schoolId, academicSession, calendarDate, calendarType])
}

model StudentEnrollmentHistory {
  id              String    @id @default(cuid())
  schoolId        String
  studentId       String
  academicSession String
  classId         String
  sectionId       String
  effectiveFrom   DateTime
  effectiveTo     DateTime?
  exitReason      String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  school          School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student         Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([schoolId, studentId, classId, sectionId, effectiveFrom])
  @@index([schoolId, classId, sectionId, academicSession, effectiveFrom])
  @@index([schoolId, studentId, effectiveFrom, effectiveTo])
}

model StudentSubjectEnrollment {
  id              String    @id @default(cuid())
  schoolId        String
  studentId       String
  subjectId       String
  academicSession String
  effectiveFrom   DateTime  @default(now())
  effectiveTo     DateTime?
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  student         Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject         Subject   @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  school          School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([studentId, subjectId, academicSession])
  @@index([schoolId, subjectId, isActive])
  @@index([schoolId, studentId, academicSession, isActive])
}

model AcademicCalendarDay {
  id                   String          @id @default(cuid())
  schoolId             String
  calendarDate         DateTime
  academicSession      String
  dayType              CalendarDayType @default(WORKING_DAY)
  title                String?
  description          String?
  endDate              DateTime?
  eventType            String?
  holidayType          String?
  applicableClassIds   String[]        @default([])
  applicableSectionIds String[]        @default([])
  applicableRoles      String[]        @default([])
  isFullDay            Boolean         @default(true)
  isSchoolWide         Boolean         @default(true)
  region               String?
  isVisible            Boolean         @default(true)
  colorCategory        String?
  isRecurring          Boolean         @default(false)
  sourceNote           String?
  createdById          String?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, calendarDate])
  @@index([schoolId, academicSession, calendarDate])
}
