// student learning domain

model Student {
  id          String  @id @default(uuid())
  schoolId    String
  admissionNo String? @unique

  // Student Information
  studentFirstName String
  studentLastName  String?
  dob              DateTime
  gender           String
  bloodGroup       String?
  category         String?
  religion         String?
  mobile           String?
  email            String?
  address          String?
  city             String?
  state            String?
  pincode          String?
  className        String
  section          String?
  rollNumber       String?
  admissionDate    DateTime?

  // Parent Information
  fatherName      String
  motherName      String?
  parentMobile    String
  alternateMobile String?
  parentEmail     String?
  occupation      String?

  // Academic Info
  session String

  // System Fields
  serialNo      Int?
  studentUserId String?
  parentUserId  String?

  // Password Fields
  studentPasswordHash         String?
  parentPasswordHash          String?
  studentMustChangePassword   Boolean   @default(false)
  parentMustChangePassword    Boolean   @default(false)
  passwordGenerated           Boolean   @default(false)
  lastPasswordGeneratedAt     DateTime?
  passwordChangedAt           DateTime?
  failedLoginAttempts         Int       @default(0)
  lockedUntil                 DateTime?
  securityQuestionsConfigured Boolean   @default(false)
  securitySetupCompletedAt    DateTime?
  recoveryEnabled             Boolean   @default(false)
  sessionVersion              Int       @default(0)

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school                    School                     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicHistory           StudentAcademicHistory[]
  studentChapterVotes       StudentChapterVote[]
  teacherStudentEvaluations TeacherStudentEvaluation[]
  chapterAssessmentResults  ChapterAssessmentResult[]
  studentChapterMasteries   StudentChapterMastery[]
  learningGaps              LearningGap[]
  learningInterventions     LearningIntervention[]
  attendances               StudentAttendance[]
  feeAssignments            FeeAssignment[]
  feeAccounts               StudentFeeAccount[]
  feeCharges                StudentFeeCharge[]
  feePayments               FeePayment[]
  feeLedgerEntries          FeeLedgerEntry[]
  feeAdjustments            FeeAdjustment[]
  feeReminders              FeeReminder[]
  feeScholarships           StudentFeeScholarship[]
  feeFamilyLinks            FeeFamilyLink[]
  feeInvoices               FeeInvoice[]
  feeInvoiceItems           FeeInvoiceItem[]
  feeRefunds                FeeRefund[]
  transportFeeAssignments   TransportFeeAssignment[]
  homeworkAudiences         HomeworkAudience[]
  homeworkSubmissions       HomeworkSubmission[]
  academicNotifications     AcademicNotification[]
  enrollmentHistory         StudentEnrollmentHistory[]
  subjectEnrollments        StudentSubjectEnrollment[]
  resourceTargets           ResourceTarget[]
  resourceActivities        ResourceActivity[]
  examinationMarks          ExaminationMark[]
  examinationResults        ExaminationStudentResult[]
  examinationSubjectResults ExaminationSubjectResult[]
  examinationReportCards    ExaminationReportCard[]

  @@unique([studentUserId])
  @@unique([parentUserId])
  @@index([schoolId])
  @@index([schoolId, session])
  @@index([schoolId, isActive, createdAt])
  @@index([schoolId, className, section, isActive])
  @@index([schoolId, isActive, className, section, createdAt])
  @@index([schoolId, className])
  @@index([mobile])
  @@index([email])
  @@index([session])
  @@index([isActive])
}

model ChapterPoll {
  id                        String            @id @default(cuid())
  schoolId                  String
  academicSessionId         String?
  classId                   String
  sectionId                 String
  subjectId                 String
  chapterId                 String
  teacherId                 String?
  createdByAdminId          String?
  title                     String
  description               String?
  pollType                  FeedbackPollType  @default(CHAPTER_COMPLETION)
  respondentTypes           Json?
  instructions              String?
  anonymousToTeacher        Boolean           @default(true)
  teacherVisibleToStudents  Boolean           @default(false)
  allowClassTeacher         Boolean           @default(false)
  commentsRequired          Boolean           @default(false)
  minimumResponsePercentage Int               @default(60)
  enabledTeacherDimensions  Json?
  enabledStudentDimensions  Json?
  status                    ChapterPollStatus @default(DRAFT)
  startAt                   DateTime?
  endAt                     DateTime?
  compiledAt                DateTime?
  publishedAt               DateTime?
  createdAt                 DateTime          @default(now())
  updatedAt                 DateTime          @updatedAt

  school          School                     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicSession AcademicSession?           @relation(fields: [academicSessionId], references: [id], onDelete: SetNull)
  class           Class                      @relation(fields: [classId], references: [id], onDelete: Cascade)
  section         Section                    @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  subject         Subject                    @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  chapter         Chapter                    @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  teacher         Teacher?                   @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  createdByAdmin  User?                      @relation("ChapterPollCreatedByAdmin", fields: [createdByAdminId], references: [id], onDelete: SetNull)
  votes           StudentChapterVote[]
  evaluations     TeacherStudentEvaluation[]
  assessments     ChapterAssessment[]
  summary         ChapterAnalysisSummary?
  auditLogs       FeedbackAuditLog[]

  @@index([schoolId, status])
  @@index([schoolId, classId, sectionId, subjectId, chapterId])
  @@index([schoolId, teacherId])
  @@index([schoolId, classId, sectionId, subjectId])
}

model StudentChapterVote {
  id                    String                @id @default(cuid())
  pollId                String
  schoolId              String
  classId               String
  sectionId             String
  subjectId             String
  chapterId             String
  studentId             String
  understandingRating   Int?
  difficultyRating      Int?
  confidenceRating      Int?
  teachingRating        Int?
  paceRating            Int?
  clarityRating         Int?
  examplesRating        Int?
  practiceRating        Int?
  resourcesRating       Int?
  interestRating        Int?
  doubtResolutionRating Int?
  testReadinessRating   Int?
  difficultArea         String?
  helpfulMethod         String?
  supportNeeded         Json?
  difficultTopic        String?
  helpfulExplanation    String?
  explainAgain          String?
  suggestion            String?
  comment               String?
  state                 FeedbackResponseState @default(IN_PROGRESS)
  version               Int                   @default(1)
  lastSavedAt           DateTime              @default(now())
  submittedAt           DateTime?
  submittedById         String?
  lockedAt              DateTime?
  snapshot              Json?

  poll    ChapterPoll @relation(fields: [pollId], references: [id], onDelete: Cascade)
  school  School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  class   Class       @relation(fields: [classId], references: [id], onDelete: Cascade)
  section Section     @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  subject Subject     @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  chapter Chapter     @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  student Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([pollId, studentId])
  @@index([schoolId, pollId])
  @@index([schoolId, studentId])
}

model TeacherStudentEvaluation {
  id                    String                @id @default(cuid())
  pollId                String
  schoolId              String
  classId               String
  sectionId             String
  subjectId             String
  chapterId             String
  teacherId             String
  studentId             String
  attentionRating       Int?
  participationRating   Int?
  homeworkRating        Int?
  conceptClarityRating  Int?
  improvementNeedRating Int?
  understandingRating   Int?
  practiceRating        Int?
  applicationRating     Int?
  confidenceRating      Int?
  improvementRating     Int?
  independenceRating    Int?
  consistencyRating     Int?
  overallScore          Float?
  remark                String?
  strengths             String?
  weaknesses            String?
  recommendation        String?
  state                 FeedbackResponseState @default(IN_PROGRESS)
  version               Int                   @default(1)
  lastSavedAt           DateTime              @default(now())
  submittedAt           DateTime?
  submittedById         String?
  lockedAt              DateTime?
  snapshot              Json?

  poll    ChapterPoll @relation(fields: [pollId], references: [id], onDelete: Cascade)
  school  School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  class   Class       @relation(fields: [classId], references: [id], onDelete: Cascade)
  section Section     @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  subject Subject     @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  chapter Chapter     @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  teacher Teacher     @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  student Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([pollId, teacherId, studentId])
  @@index([schoolId, pollId])
  @@index([schoolId, teacherId])
  @@index([schoolId, studentId])
}

model FeedbackTemplate {
  id                        String           @id @default(cuid())
  schoolId                  String
  createdById               String?
  name                      String
  pollType                  FeedbackPollType @default(CHAPTER_COMPLETION)
  instructions              String?
  respondentTypes           Json?
  teacherDimensions         Json
  studentDimensions         Json
  anonymousToTeacher        Boolean          @default(true)
  teacherVisibleToStudents  Boolean          @default(false)
  commentsRequired          Boolean          @default(false)
  minimumResponsePercentage Int              @default(60)
  isActive                  Boolean          @default(true)
  createdAt                 DateTime         @default(now())
  updatedAt                 DateTime         @updatedAt

  school    School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  createdBy User?  @relation("FeedbackTemplateCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([schoolId, name])
  @@index([schoolId, isActive])
}

model FeedbackAuditLog {
  id         String   @id @default(cuid())
  schoolId   String
  pollId     String?
  actorId    String?
  actorRole  String
  action     String
  entityType String
  entityId   String?
  previous   Json?
  current    Json?
  reason     String?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  school School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  poll   ChapterPoll? @relation(fields: [pollId], references: [id], onDelete: SetNull)
  actor  User?        @relation("FeedbackAuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([schoolId, pollId, createdAt])
  @@index([schoolId, action])
}

model ChapterAnalysisSummary {
  id                        String   @id @default(cuid())
  pollId                    String   @unique
  schoolId                  String
  classId                   String
  sectionId                 String
  subjectId                 String
  chapterId                 String
  teacherId                 String?
  compiledByAdminId         String?
  overallUnderstandingScore Float
  overallTeachingScore      Float
  classStrengths            Json
  classWeaknesses           Json
  teacherStrengths          Json
  teacherImprovementAreas   Json
  studentSummaries          Json
  riskStudents              Json
  topperStudents            Json
  recommendations           Json
  adminNotes                String?
  isPublished               Boolean  @default(false)
  compiledAt                DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  poll            ChapterPoll @relation(fields: [pollId], references: [id], onDelete: Cascade)
  school          School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  class           Class       @relation(fields: [classId], references: [id], onDelete: Cascade)
  section         Section     @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  subject         Subject     @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  chapter         Chapter     @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  teacher         Teacher?    @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  compiledByAdmin User?       @relation("ChapterAnalysisCompiledByAdmin", fields: [compiledByAdminId], references: [id], onDelete: SetNull)

  @@index([schoolId, classId, sectionId, subjectId])
  @@index([schoolId, isPublished])
}

model ChapterAssessment {
  id             String         @id @default(cuid())
  schoolId       String
  classId        String
  sectionId      String
  subjectId      String
  chapterId      String
  pollId         String?
  teacherId      String?
  title          String
  assessmentType AssessmentType @default(CHAPTER_QUIZ)
  assessmentDate DateTime?
  maxScore       Float
  notes          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  school     School                    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  class      Class                     @relation(fields: [classId], references: [id], onDelete: Cascade)
  section    Section                   @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  subject    Subject                   @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  chapter    Chapter                   @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  teacher    Teacher?                  @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  poll       ChapterPoll?              @relation(fields: [pollId], references: [id], onDelete: SetNull)
  results    ChapterAssessmentResult[]
  components AssessmentComponent[]

  @@index([schoolId, classId, sectionId, subjectId])
  @@index([schoolId, chapterId])
  @@index([schoolId, pollId])
}

model ChapterAssessmentResult {
  id                 String   @id @default(cuid())
  assessmentId       String
  schoolId           String
  classId            String
  sectionId          String
  subjectId          String
  chapterId          String
  studentId          String
  rawScore           Float
  maxScore           Float
  normalizedScore    Float
  isReassessment     Boolean  @default(false)
  reassessmentNumber Int      @default(0)
  notes              String?
  recordedAt         DateTime @default(now())
  updatedAt          DateTime @updatedAt

  assessment ChapterAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  school     School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  class      Class             @relation(fields: [classId], references: [id], onDelete: Cascade)
  section    Section           @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  subject    Subject           @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  chapter    Chapter           @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  student    Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([assessmentId, studentId])
  @@index([schoolId, studentId, chapterId])
  @@index([schoolId, classId, sectionId, subjectId, chapterId])
}

model StudentChapterMastery {
  id                 String            @id @default(cuid())
  schoolId           String
  classId            String
  sectionId          String
  subjectId          String
  chapterId          String
  studentId          String
  score              Float?
  masteryLevel       MasteryLevel?
  confidence         MasteryConfidence @default(INSUFFICIENT_DATA)
  componentBreakdown Json
  dataCompleteness   Json
  summary            String?
  calculatedAt       DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  school  School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  class   Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  section Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  chapter Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([schoolId, classId, sectionId, subjectId, chapterId, studentId], map: "StudentChapterMastery_scope_student_key")
  @@index([schoolId, studentId])
  @@index([schoolId, classId, sectionId, subjectId, chapterId], map: "StudentChapterMastery_scope_idx")
  @@index([schoolId, masteryLevel])
}

model LearningGap {
  id          String    @id @default(cuid())
  schoolId    String
  classId     String
  sectionId   String
  subjectId   String
  chapterId   String
  studentId   String?
  gapType     String
  severity    String
  explanation String
  evidence    Json
  isResolved  Boolean   @default(false)
  detectedAt  DateTime  @default(now())
  resolvedAt  DateTime?

  school  School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  class   Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  section Section  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  subject Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  chapter Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  student Student? @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([schoolId, classId, sectionId, subjectId, chapterId])
  @@index([schoolId, studentId, isResolved])
}

model LearningIntervention {
  id                   String             @id @default(cuid())
  schoolId             String
  classId              String
  sectionId            String
  subjectId            String
  chapterId            String
  studentId            String
  assignedTeacherId    String?
  createdByUserId      String?
  assignedToUserId     String?
  interventionType     String             @default("REMEDIAL_CLASS")
  title                String?
  priority             String             @default("MEDIUM")
  reason               String
  recommendedAction    String
  status               InterventionStatus @default(PLANNED)
  startDate            DateTime?
  dueDate              DateTime?
  completedAt          DateTime?
  notes                String?
  outcome              String?
  followUpDate         DateTime?
  parentVisible        Boolean            @default(false)
  confidentialNotes    String?
  reassessmentRequired Boolean            @default(true)
  beforeScore          Float?
  afterScore           Float?
  improvement          Float?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  school          School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  class           Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  section         Section  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  subject         Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  chapter         Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  student         Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  assignedTeacher Teacher? @relation("InterventionAssignedTeacher", fields: [assignedTeacherId], references: [id], onDelete: SetNull)

  @@index([schoolId, studentId, status])
  @@index([schoolId, assignedTeacherId, status])
  @@index([schoolId, classId, sectionId, subjectId, chapterId])
  @@index([schoolId, createdAt])
}

model StudentAcademicHistory {
  id         String   @id @default(uuid())
  studentId  String
  className  String
  section    String?
  session    String
  rollNumber String?
  promotedOn DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, session])
  @@index([session])
}
