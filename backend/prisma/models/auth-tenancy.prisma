// auth tenancy domain

model User {
  id                       String                     @id @default(cuid())
  email                    String                     @unique
  password                 String
  name                     String
  contactEmail             String?
  role                     Role                       @default(STUDENT)
  schoolId                 String?
  classId                  String?
  sectionId                String?
  employeeId               String?
  joiningYear              Int?
  school                   School?                    @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  class                    Class?                     @relation("ClassUsers", fields: [classId], references: [id], onDelete: SetNull)
  section                  Section?                   @relation("SectionUsers", fields: [sectionId], references: [id], onDelete: SetNull)
  activityEnrollments      ActivityEnrollment[]
  widgetPreferences        UserWidgetPreference[]
  widgetTodos              UserWidgetTodo[]
  widgetNotes              UserWidgetNote[]
  widgetBookmarks          UserWidgetBookmark[]
  widgetNotifications      UserWidgetNotification[]
  widgetActivities         UserWidgetActivity[]
  loginStreaks             UserLoginStreak[]
  createdSystemContents    SystemContent[]
  createdChapterPolls      ChapterPoll[]              @relation("ChapterPollCreatedByAdmin")
  compiledChapterSummaries ChapterAnalysisSummary[]   @relation("ChapterAnalysisCompiledByAdmin")
  createdFeedbackTemplates FeedbackTemplate[]         @relation("FeedbackTemplateCreatedBy")
  feedbackAuditActions     FeedbackAuditLog[]         @relation("FeedbackAuditActor")
  markedStudentAttendances StudentAttendance[]        @relation("StudentAttendanceMarkedBy")
  markedTeacherAttendances TeacherAttendance[]        @relation("TeacherAttendanceMarkedBy")
  reportedIssues           IssueReport[]              @relation("IssueReporter")
  assignedIssues           IssueReport[]              @relation("IssueAssignee")
  issueMessages            IssueReportMessage[]
  issueAuditActions        IssueReportAudit[]         @relation("IssueAuditActor")
  createdHomework          Homework[]                 @relation("HomeworkCreator")
  reviewedSubmissions      HomeworkSubmission[]       @relation("SubmissionReviewer")
  uploadedAcademicFiles    AcademicAttachment[]       @relation("AcademicAttachmentUploader")
  academicAuditActions     AcademicContentAudit[]     @relation("AcademicContentAuditActor")
  staffingAuditActions     AcademicStaffingAuditLog[] @relation("AcademicStaffingAuditActor")
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @updatedAt

  // Optional profile fields (backwards-compatible additions)
  profileImage                String?
  alternateMobile             String?
  isActive                    Boolean             @default(true)
  mustChangePassword          Boolean             @default(false)
  passwordChangedAt           DateTime?
  lastLoginAt                 DateTime?
  failedLoginAttempts         Int                 @default(0)
  lockedUntil                 DateTime?
  securityQuestionsConfigured Boolean             @default(false)
  securitySetupCompletedAt    DateTime?
  recoveryEnabled             Boolean             @default(false)
  sessionVersion              Int                 @default(0)
  lastActiveRoleId            String?
  roleAssignments             UserSchoolRole[]
  workspaceAuditEvents        WorkspaceAuditLog[]
  authSessions                AuthSession[]

  @@unique([schoolId, employeeId])
  @@index([email])
  @@index([role])
  @@index([schoolId, role])
  @@index([classId])
  @@index([sectionId])
}

// A user's responsibilities are independent workspaces. User.role remains
// temporarily for repeat-safe migration and compatibility with old clients.

model UserSchoolRole {
  id              String      @id @default(cuid())
  userId          String
  schoolId        String
  role            Role
  isActive        Boolean     @default(true)
  isDefault       Boolean     @default(false)
  validFrom       DateTime?
  validUntil      DateTime?
  assignmentNotes String?
  assignedById    String?
  updatedById     String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  school          School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  scopes          RoleScope[]

  @@unique([userId, schoolId, role])
  @@index([userId, schoolId, isActive])
  @@index([schoolId, role, isActive])
}

model RoleScope {
  id               String         @id @default(cuid())
  roleAssignmentId String
  scopeType        String
  classId          String?
  sectionId        String?
  subjectId        String?
  sessionId        String?
  examinationId    String?
  metadata         Json?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  roleAssignment   UserSchoolRole @relation(fields: [roleAssignmentId], references: [id], onDelete: Cascade)

  @@index([roleAssignmentId, scopeType])
  @@index([classId, sectionId, subjectId])
}

model WorkspaceAuditLog {
  id               String   @id @default(cuid())
  userId           String
  schoolId         String
  activeRole       Role
  roleAssignmentId String?
  action           String
  entityType       String?
  entityId         String?
  oldValue         Json?
  newValue         Json?
  reason           String?
  ipAddress        String?
  userAgent        String?
  sessionId        String?
  createdAt        DateTime @default(now())
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  school           School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, createdAt])
  @@index([userId, roleAssignmentId, createdAt])
  @@index([action, entityType, entityId])
}

model SeparationOfDutiesPolicy {
  id                        String   @id @default(cuid())
  schoolId                  String   @unique
  mode                      String   @default("STRICT")
  principalApprovalRequired Boolean  @default(false)
  workflows                 Json?
  updatedById               String?
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt
  school                    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
}

model AuthSession {
  id               String    @id
  userId           String
  schoolId         String?
  roleAssignmentId String?
  refreshTokenHash String
  tokenVersion     Int       @default(1)
  expiresAt        DateTime
  revokedAt        DateTime?
  lastUsedAt       DateTime  @default(now())
  ipAddress        String?
  userAgent        String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

