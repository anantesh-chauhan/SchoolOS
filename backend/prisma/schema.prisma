// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User Model
model User {
  id                       String                   @id @default(cuid())
  email                    String                   @unique
  password                 String
  name                     String
  contactEmail             String?
  role                     Role                     @default(STUDENT)
  schoolId                 String?
  classId                  String?
  sectionId                String?
  employeeId               String?
  joiningYear              Int?
  school                   School?                  @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  class                    Class?                   @relation("ClassUsers", fields: [classId], references: [id], onDelete: SetNull)
  section                  Section?                 @relation("SectionUsers", fields: [sectionId], references: [id], onDelete: SetNull)
  activityEnrollments      ActivityEnrollment[]
  widgetPreferences        UserWidgetPreference[]
  widgetTodos              UserWidgetTodo[]
  widgetNotes              UserWidgetNote[]
  widgetBookmarks          UserWidgetBookmark[]
  widgetNotifications      UserWidgetNotification[]
  widgetActivities         UserWidgetActivity[]
  loginStreaks             UserLoginStreak[]
  createdSystemContents    SystemContent[]
  createdChapterPolls      ChapterPoll[]            @relation("ChapterPollCreatedByAdmin")
  compiledChapterSummaries ChapterAnalysisSummary[] @relation("ChapterAnalysisCompiledByAdmin")
  markedStudentAttendances StudentAttendance[]      @relation("StudentAttendanceMarkedBy")
  markedTeacherAttendances TeacherAttendance[]      @relation("TeacherAttendanceMarkedBy")
  reportedIssues           IssueReport[]            @relation("IssueReporter")
  assignedIssues           IssueReport[]            @relation("IssueAssignee")
  issueMessages            IssueReportMessage[]
  issueAuditActions        IssueReportAudit[]       @relation("IssueAuditActor")
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt

  // Optional profile fields (backwards-compatible additions)
  profileImage                String?
  alternateMobile             String?
  isActive                    Boolean   @default(true)
  mustChangePassword          Boolean   @default(false)
  passwordChangedAt           DateTime?
  lastLoginAt                 DateTime?
  failedLoginAttempts         Int       @default(0)
  lockedUntil                 DateTime?
  securityQuestionsConfigured Boolean   @default(false)
  securitySetupCompletedAt    DateTime?
  recoveryEnabled             Boolean   @default(false)
  sessionVersion              Int       @default(0)

  @@unique([schoolId, employeeId])
  @@index([email])
  @@index([role])
  @@index([schoolId, role])
  @@index([classId])
  @@index([sectionId])
}

// School Model
model School {
  id                        String                     @id @default(cuid())
  schoolName                String
  schoolCode                String                     @unique
  slug                      String                     @unique
  address                   String
  logoUrl                   String?
  city                      String
  state                     String
  phone                     String
  email                     String
  status                    SchoolStatus               @default(ACTIVE)
  theme                     Json?
  config                    Json?
  users                     User[]
  classes                   Class[]
  sections                  Section[]
  subjects                  Subject[]
  chapters                  Chapter[]
  chapterProgress           ChapterProgress[]
  sectionResources          SectionResource[]
  subjectWeeklyRequirements SubjectWeeklyRequirement[]
  teachers                  Teacher[]
  teacherAssignments        TeacherAssignment[]
  timetables                Timetable[]
  timetableSlots            TimetableSlot[]
  galleryGroups             GalleryGroup[]
  galleryPhotos             GalleryPhoto[]
  settings                  SchoolSettings?
  academicLevels            AcademicLevel[]
  streams                   Stream[]
  streamSubjects            StreamSubject[]
  classStreams              ClassStream[]
  subjectComponents         SubjectComponent[]
  activities                Activity[]
  activityEnrollments       ActivityEnrollment[]
  periodDefinitions         PeriodDefinition[]
  teacherSubjects           TeacherSubject[]
  labRooms                  LabRoom[]
  labSubjectRules           LabSubjectRule[]
  widgetPreferences         UserWidgetPreference[]
  widgetTodos               UserWidgetTodo[]
  widgetNotes               UserWidgetNote[]
  widgetBookmarks           UserWidgetBookmark[]
  widgetNotifications       UserWidgetNotification[]
  widgetActivities          UserWidgetActivity[]
  loginStreaks              UserLoginStreak[]
  systemContents            SystemContent[]
  students                  Student[]
  chapterPolls              ChapterPoll[]
  studentChapterVotes       StudentChapterVote[]
  teacherStudentEvaluations TeacherStudentEvaluation[]
  chapterAnalysisSummaries  ChapterAnalysisSummary[]
  chapterAssessments        ChapterAssessment[]
  chapterAssessmentResults  ChapterAssessmentResult[]
  studentChapterMasteries   StudentChapterMastery[]
  learningGaps              LearningGap[]
  learningInterventions     LearningIntervention[]
  studentAttendances        StudentAttendance[]
  teacherAttendances        TeacherAttendance[]
  academicCalendarDays      AcademicCalendarDay[]
  issueReports              IssueReport[]
  securityQuestions         UserSecurityQuestion[]
  passwordResetTokens       PasswordResetToken[]
  securityAuditLogs         SecurityAuditLog[]
  curricula                 Curriculum[]
  curriculumVersions        CurriculumVersion[]
  publishers                Publisher[]
  books                     Book[]
  curriculumUnits           CurriculumUnit[]
  curriculumAuditLogs       CurriculumAuditLog[]
  feeModuleSetting          FeeModuleSetting?
  feeStructures             FeeStructure[]
  feeComponents             FeeComponent[]
  feeAssignments            FeeAssignment[]
  studentFeeAccounts        StudentFeeAccount[]
  feeCharges                StudentFeeCharge[]
  feePayments               FeePayment[]
  feeReceipts               FeeReceipt[]
  feeLedgerEntries          FeeLedgerEntry[]
  feeAdjustments            FeeAdjustment[]
  feeApprovalRequests       FeeApprovalRequest[]
  feeReminders              FeeReminder[]
  feeAuditLogs              FeeAuditLog[]
  feeScholarships           FeeScholarship[]
  feeNotificationTemplates  FeeNotificationTemplate[]
  feeDailyCashClosings      FeeDailyCashClosing[]
  feeFinancialPeriods       FeeFinancialPeriod[]
  feeDocuments              FeeDocument[]
  feeFamilyLinks            FeeFamilyLink[]
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt

  @@index([schoolName])
  @@index([city, state])
}

model IssueReport {
  id                 String        @id @default(cuid())
  title              String
  description        String
  category           IssueCategory
  priority           IssuePriority @default(MEDIUM)
  status             IssueStatus   @default(OPEN)
  stepsToReproduce   String?
  expectedResult     String?
  actualResult       String?
  additionalComment  String?
  currentRoute       String?
  moduleName         String?
  browser            String?
  operatingSystem    String?
  deviceType         String?
  screenResolution   String?
  applicationVersion String?
  screenshotUrl      String?
  screenshotPublicId String?
  reporterId         String
  reporterRole       String
  reporterName       String?
  reporterEmail      String?
  schoolId           String?
  schoolName         String?
  assignedToId       String?
  platformNote       String?
  resolutionNote     String?
  firstResponseAt    DateTime?
  resolvedAt         DateTime?
  closedAt           DateTime?
  reopenedCount      Int           @default(0)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  reporter User                 @relation("IssueReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  assignee User?                @relation("IssueAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  school   School?              @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  messages IssueReportMessage[]
  audits   IssueReportAudit[]

  @@index([reporterId, createdAt])
  @@index([schoolId])
  @@index([status])
  @@index([priority])
  @@index([category])
  @@index([createdAt])
}

model IssueReportMessage {
  id         String      @id @default(cuid())
  issueId    String
  senderId   String
  senderRole String
  message    String
  isInternal Boolean     @default(false)
  createdAt  DateTime    @default(now())
  issue      IssueReport @relation(fields: [issueId], references: [id], onDelete: Cascade)
  sender     User        @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([issueId, createdAt])
  @@index([senderId])
}

model IssueReportAudit {
  id        String      @id @default(cuid())
  issueId   String
  actorId   String
  action    String
  metadata  Json?
  createdAt DateTime    @default(now())
  issue     IssueReport @relation(fields: [issueId], references: [id], onDelete: Cascade)
  actor     User        @relation("IssueAuditActor", fields: [actorId], references: [id], onDelete: Cascade)

  @@index([issueId, createdAt])
  @@index([actorId])
}

model GalleryGroup {
  id            String   @id @default(uuid())
  schoolId      String
  title         String
  description   String?
  coverImageUrl String?
  isVisible     Boolean  @default(true)
  displayOrder  Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  school School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  photos GalleryPhoto[]

  @@unique([schoolId, title])
  @@index([schoolId, isVisible, displayOrder])
  @@index([schoolId, createdAt])
}

model GalleryPhoto {
  id           String   @id @default(uuid())
  schoolId     String
  groupId      String
  imageUrl     String
  caption      String?
  isVisible    Boolean  @default(true)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())

  school School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  group  GalleryGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([schoolId, groupId, isVisible, displayOrder])
  @@index([groupId, displayOrder])
}

model SchoolSettings {
  id             String   @id @default(uuid())
  schoolId       String   @unique
  schoolName     String
  logoUrl        String?
  email          String?
  phone          String?
  addressLine1   String?
  addressLine2   String?
  city           String?
  state          String?
  country        String?
  postalCode     String?
  website        String?
  supportEmail   String?
  primaryColor   String   @default("#0f766e")
  secondaryColor String   @default("#0f172a")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
}

model Class {
  id                        String                     @id @default(cuid())
  className                 String
  classOrder                Int
  schoolId                  String
  academicLevelId           String?
  school                    School                     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicLevel             AcademicLevel?             @relation(fields: [academicLevelId], references: [id], onDelete: SetNull)
  sections                  Section[]
  users                     User[]                     @relation("ClassUsers")
  classSubjects             ClassSubject[]
  subjectWeeklyRequirements SubjectWeeklyRequirement[]
  teacherAssignments        TeacherAssignment[]
  timetables                Timetable[]
  timetableSlots            TimetableSlot[]
  classStreams              ClassStream[]
  teacherSubjects           TeacherSubject[]
  chapters                  Chapter[]
  chapterProgress           ChapterProgress[]
  sectionResources          SectionResource[]
  chapterPolls              ChapterPoll[]
  studentChapterVotes       StudentChapterVote[]
  teacherStudentEvaluations TeacherStudentEvaluation[]
  chapterAnalysisSummaries  ChapterAnalysisSummary[]
  chapterAssessments        ChapterAssessment[]
  chapterAssessmentResults  ChapterAssessmentResult[]
  studentChapterMasteries   StudentChapterMastery[]
  learningGaps              LearningGap[]
  learningInterventions     LearningIntervention[]
  studentAttendances        StudentAttendance[]
  books                     Book[]
  curriculumUnits           CurriculumUnit[]
  deletedAt                 DateTime?
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt

  @@unique([schoolId, className])
  @@unique([schoolId, classOrder])
  @@index([schoolId, classOrder])
  @@index([academicLevelId])
}

model Section {
  id                        String                     @id @default(cuid())
  sectionName               String
  sectionOrder              Int
  classId                   String
  schoolId                  String
  streamId                  String?
  class                     Class                      @relation(fields: [classId], references: [id], onDelete: Cascade)
  school                    School                     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  stream                    Stream?                    @relation(fields: [streamId], references: [id], onDelete: SetNull)
  users                     User[]                     @relation("SectionUsers")
  sectionSubjects           SectionSubject[]
  subjectWeeklyRequirements SubjectWeeklyRequirement[]
  teacherAssignments        TeacherAssignment[]
  timetables                Timetable[]
  timetableSlots            TimetableSlot[]
  classStreams              ClassStream[]
  teacherSubjects           TeacherSubject[]
  chapters                  Chapter[]
  chapterProgress           ChapterProgress[]
  sectionResources          SectionResource[]
  chapterPolls              ChapterPoll[]
  studentChapterVotes       StudentChapterVote[]
  teacherStudentEvaluations TeacherStudentEvaluation[]
  chapterAnalysisSummaries  ChapterAnalysisSummary[]
  chapterAssessments        ChapterAssessment[]
  chapterAssessmentResults  ChapterAssessmentResult[]
  studentChapterMasteries   StudentChapterMastery[]
  learningGaps              LearningGap[]
  learningInterventions     LearningIntervention[]
  studentAttendances        StudentAttendance[]
  deletedAt                 DateTime?
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt

  @@unique([classId, sectionName])
  @@unique([classId, sectionOrder])
  @@index([classId, sectionOrder])
  @@index([schoolId])
  @@index([streamId])
}

model Subject {
  id                        String                     @id @default(cuid())
  subjectName               String
  subjectCode               String
  parentSubjectId           String?
  subjectType               SubjectType                @default(CORE)
  isLab                     Boolean                    @default(false)
  isOptional                Boolean                    @default(false)
  displayOrder              Int                        @default(0)
  category                  SubjectCategory?
  stream                    StreamType?
  isCustom                  Boolean                    @default(false)
  schoolId                  String
  school                    School                     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  parentSubject             Subject?                   @relation("SubjectHierarchy", fields: [parentSubjectId], references: [id], onDelete: SetNull)
  childSubjects             Subject[]                  @relation("SubjectHierarchy")
  classSubjects             ClassSubject[]
  sectionSubjects           SectionSubject[]
  subjectWeeklyRequirements SubjectWeeklyRequirement[]
  teacherAssignments        TeacherAssignment[]
  timetableSlots            TimetableSlot[]
  subjectComponents         SubjectComponent[]
  streamSubjects            StreamSubject[]
  teacherSubjects           TeacherSubject[]
  labRules                  LabSubjectRule[]
  chapters                  Chapter[]
  chapterProgress           ChapterProgress[]
  sectionResources          SectionResource[]
  chapterPolls              ChapterPoll[]
  studentChapterVotes       StudentChapterVote[]
  teacherStudentEvaluations TeacherStudentEvaluation[]
  chapterAnalysisSummaries  ChapterAnalysisSummary[]
  chapterAssessments        ChapterAssessment[]
  chapterAssessmentResults  ChapterAssessmentResult[]
  studentChapterMasteries   StudentChapterMastery[]
  learningGaps              LearningGap[]
  learningInterventions     LearningIntervention[]
  books                     Book[]
  curriculumUnits           CurriculumUnit[]
  deletedAt                 DateTime?
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt

  @@unique([schoolId, subjectName])
  @@unique([schoolId, subjectCode])
  @@index([schoolId])
  @@index([parentSubjectId])
}

model Chapter {
  id                   String    @id @default(cuid())
  schoolId             String
  classId              String?
  sectionId            String?
  subjectId            String
  chapterName          String
  chapterNumber        Int
  status               String    @default("not_started")
  estimatedClasses     Int       @default(4)
  resourcesCount       Int       @default(0)
  assignmentsCount     Int       @default(0)
  completion           Int       @default(0)
  deletedAt            DateTime?
  curriculumVersionId  String?
  bookId               String?
  unitId               String?
  academicSession      String?
  description          String?
  learningObjectives   Json?
  teachingOrder        Int?
  difficultyLevel      String?
  startDate            DateTime?
  targetCompletionDate DateTime?
  publicationStatus    String    @default("PUBLISHED")
  resourcePreference   String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  school                    School                     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  class                     Class?                     @relation(fields: [classId], references: [id], onDelete: Cascade)
  section                   Section?                   @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  subject                   Subject                    @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  progress                  ChapterProgress[]
  resources                 SectionResource[]
  chapterPolls              ChapterPoll[]
  studentChapterVotes       StudentChapterVote[]
  teacherStudentEvaluations TeacherStudentEvaluation[]
  chapterAnalysisSummaries  ChapterAnalysisSummary[]
  chapterAssessments        ChapterAssessment[]
  chapterAssessmentResults  ChapterAssessmentResult[]
  studentChapterMasteries   StudentChapterMastery[]
  learningGaps              LearningGap[]
  learningInterventions     LearningIntervention[]
  curriculumVersion         CurriculumVersion?         @relation(fields: [curriculumVersionId], references: [id], onDelete: SetNull)
  book                      Book?                      @relation(fields: [bookId], references: [id], onDelete: SetNull)
  unit                      CurriculumUnit?            @relation(fields: [unitId], references: [id], onDelete: SetNull)

  @@unique([schoolId, classId, sectionId, subjectId, chapterName])
  @@unique([schoolId, classId, sectionId, subjectId, chapterNumber])
  @@index([schoolId, classId, sectionId])
  @@index([schoolId, subjectId])
  @@index([schoolId, status])
  @@index([schoolId, curriculumVersionId])
  @@index([schoolId, bookId])
  @@index([schoolId, unitId])
}

model ClassSubject {
  id             String   @id @default(cuid())
  classId        String
  subjectId      String
  periodsPerWeek Int?
  isOptional     Boolean  @default(false)
  class          Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject        Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())

  @@unique([classId, subjectId])
  @@index([classId])
  @@index([subjectId])
}

model SectionSubject {
  id        String   @id @default(cuid())
  sectionId String
  subjectId String
  section   Section  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([sectionId, subjectId])
  @@index([sectionId])
  @@index([subjectId])
}

model Teacher {
  id                        String                     @id @default(cuid())
  teacherName               String
  email                     String
  phone                     String
  employeeId                String
  joiningYear               Int?
  qualification             String?
  specialization            String?
  subjectsHandled           String[]                   @default([])
  schoolId                  String
  school                    School                     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  teacherAssignments        TeacherAssignment[]
  chapterProgress           ChapterProgress[]
  sectionResources          SectionResource[]
  chapterPolls              ChapterPoll[]
  teacherStudentEvaluations TeacherStudentEvaluation[]
  chapterAnalysisSummaries  ChapterAnalysisSummary[]
  chapterAssessments        ChapterAssessment[]
  learningInterventions     LearningIntervention[]     @relation("InterventionAssignedTeacher")
  teacherAttendances        TeacherAttendance[]
  teacherSubjects           TeacherSubject[]
  timetableSlots            TimetableSlot[]
  deletedAt                 DateTime?
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt

  @@unique([schoolId, email])
  @@unique([schoolId, employeeId])
  @@index([schoolId, teacherName])
  @@index([schoolId, specialization])
}

model TeacherAssignment {
  id            String                    @id @default(cuid())
  teacherId     String
  subjectId     String
  classId       String
  sectionId     String
  schoolId      String
  roleType      TeacherAssignmentRoleType @default(SUBJECT_TEACHER)
  isActive      Boolean                   @default(true)
  isTemporary   Boolean                   @default(false)
  effectiveFrom DateTime                  @default(now())
  effectiveTo   DateTime?
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt

  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  class   Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  section Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  school  School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, teacherId, classId, sectionId, subjectId])
  @@index([teacherId])
  @@index([schoolId, teacherId, isActive])
  @@index([schoolId, sectionId])
  @@index([schoolId, subjectId])
  @@index([schoolId, classId, sectionId])
}

model ChapterProgress {
  id          String                @id @default(cuid())
  schoolId    String
  classId     String
  sectionId   String
  subjectId   String
  chapterId   String
  teacherId   String?
  status      ChapterProgressStatus @default(NOT_STARTED)
  remarks     String?
  completedAt DateTime?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  school  School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  class   Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  section Section  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  subject Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  chapter Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  teacher Teacher? @relation(fields: [teacherId], references: [id], onDelete: SetNull)

  @@unique([schoolId, classId, sectionId, subjectId, chapterId])
  @@index([schoolId, teacherId])
  @@index([schoolId, classId, sectionId, subjectId])
  @@index([schoolId, status])
}

model SectionResource {
  id                  String              @id @default(cuid())
  schoolId            String
  classId             String
  sectionId           String
  subjectId           String
  chapterId           String?
  teacherId           String?
  title               String
  description         String?
  resourceType        SectionResourceType @default(NOTE)
  fileUrl             String?
  externalUrl         String?
  isVisibleToStudents Boolean             @default(true)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  school  School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  class   Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  section Section  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  subject Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  chapter Chapter? @relation(fields: [chapterId], references: [id], onDelete: SetNull)
  teacher Teacher? @relation(fields: [teacherId], references: [id], onDelete: SetNull)

  @@index([schoolId, classId, sectionId, subjectId])
  @@index([schoolId, teacherId])
  @@index([schoolId, chapterId])
  @@index([schoolId, isVisibleToStudents])
}

model SubjectWeeklyRequirement {
  id             String   @id @default(cuid())
  classId        String
  sectionId      String?
  subjectId      String
  periodsPerWeek Int
  isMandatory    Boolean  @default(true)
  isOptional     Boolean  @default(false)
  schoolId       String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  class   Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  section Section? @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  subject Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  school  School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, classId, sectionId, subjectId])
  @@index([schoolId, classId, sectionId])
  @@index([schoolId, subjectId])
}

model Timetable {
  id           String   @id @default(cuid())
  classId      String
  sectionId    String
  schoolId     String
  academicYear String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  class   Class           @relation(fields: [classId], references: [id], onDelete: Cascade)
  section Section         @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  school  School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  slots   TimetableSlot[]

  @@unique([schoolId, classId, sectionId, academicYear])
  @@index([schoolId, classId])
  @@index([schoolId, sectionId])
}

model TimetableSlot {
  id                 String    @id @default(cuid())
  timetableId        String
  dayOfWeek          DayOfWeek
  periodNumber       Int?
  sequenceOrder      Int
  slotType           SlotType  @default(PERIOD)
  slotLabel          String?
  startTime          String
  endTime            String
  subjectId          String?
  subjectComponentId String?
  teacherId          String?
  activityId         String?
  labRoomId          String?
  isActivityPeriod   Boolean   @default(false)
  classId            String
  sectionId          String
  schoolId           String
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  timetable        Timetable         @relation(fields: [timetableId], references: [id], onDelete: Cascade)
  subject          Subject?          @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  subjectComponent SubjectComponent? @relation(fields: [subjectComponentId], references: [id], onDelete: SetNull)
  teacher          Teacher?          @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  activity         Activity?         @relation(fields: [activityId], references: [id], onDelete: SetNull)
  labRoom          LabRoom?          @relation(fields: [labRoomId], references: [id], onDelete: SetNull)
  class            Class             @relation(fields: [classId], references: [id], onDelete: Cascade)
  section          Section           @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  school           School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([timetableId, dayOfWeek, sequenceOrder])
  @@index([timetableId, dayOfWeek])
  @@index([schoolId, teacherId, dayOfWeek, startTime, endTime])
  @@index([schoolId, classId, sectionId])
  @@index([subjectComponentId])
  @@index([activityId])
  @@index([labRoomId])
}

model AcademicLevel {
  id                String    @id @default(uuid())
  schoolId          String?
  code              String
  name              String
  minClassOrder     Int
  maxClassOrder     Int
