// Fee and financial management. Monetary values are stored in minor units.
model FeeModuleSetting {
  id                      String           @id @default(cuid())
  schoolId                String           @unique
  enabled                 Boolean          @default(false)
  mode                    FeeStructureMode @default(SIMPLE)
  currencyCode            String           @default("INR")
  currencySymbol          String           @default("₹")
  locale                  String           @default("en-IN")
  decimalPrecision        Int              @default(2)
  financialYearStartMonth Int              @default(4)
  dateFormat              String           @default("dd/MM/yyyy")
  receiptFormat           String           @default("{SCHOOL}/{SESSION}/FEE/{SEQ}")
  nextReceiptSequence     Int              @default(1)
  approvalThresholdMinor  BigInt           @default(50000)
  allowPlatformSummary    Boolean          @default(false)
  gatewayEnabled          Boolean          @default(false)
  createdById             String?
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt
  school                  School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
}

model FeeStructure {
  id              String             @id @default(cuid())
  schoolId        String
  academicSession String
  name            String
  code            String
  description     String?
  mode            FeeStructureMode
  version         Int                @default(1)
  status          FeeStructureStatus @default(DRAFT)
  effectiveFrom   DateTime?
  effectiveTo     DateTime?
  publishedAt     DateTime?
  createdById     String?
  approvedById    String?
  changeReason    String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  school          School             @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  components      FeeComponent[]
  assignments     FeeAssignment[]
  charges         StudentFeeCharge[]

  @@unique([schoolId, academicSession, code, version])
  @@index([schoolId, academicSession, status])
}

model FeeComponent {
  id              String             @id @default(cuid())
  schoolId        String
  feeStructureId  String
  academicSession String
  name            String
  code            String
  description     String?
  feeType         String?
  amountMinor     BigInt
  frequency       FeeFrequency
  dueDay          Int?
  gracePeriodDays Int                @default(0)
  lateFeeRule     Json?
  taxable         Boolean            @default(false)
  refundable      Boolean            @default(false)
  mandatory       Boolean            @default(true)
  displayOrder    Int                @default(0)
  active          Boolean            @default(true)
  effectiveFrom   DateTime?
  effectiveTo     DateTime?
  applicability   Json?
  createdById     String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  school          School             @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  feeStructure    FeeStructure       @relation(fields: [feeStructureId], references: [id], onDelete: Restrict)
  charges         StudentFeeCharge[]

  @@unique([schoolId, feeStructureId, code])
  @@index([schoolId, academicSession, active])
}

model FeeAssignment {
  id              String              @id @default(cuid())
  schoolId        String
  academicSession String
  feeStructureId  String
  studentId       String?
  targetType      FeeAssignmentTarget
  targetValue     String?
  priority        Int
  active          Boolean             @default(true)
  effectiveFrom   DateTime?
  effectiveTo     DateTime?
  createdById     String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  school          School              @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  feeStructure    FeeStructure        @relation(fields: [feeStructureId], references: [id], onDelete: Restrict)
  student         Student?            @relation(fields: [studentId], references: [id], onDelete: Restrict)

  @@index([schoolId, academicSession, targetType, targetValue])
  @@index([schoolId, studentId, active])
}

model StudentFeeAccount {
  id                  String             @id @default(cuid())
  schoolId            String
  studentId           String
  academicSession     String
  status              FeeAccountStatus   @default(ACTIVE)
  advanceBalanceMinor BigInt             @default(0)
  carriedForwardMinor BigInt             @default(0)
  lockedAt            DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  school              School             @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  student             Student            @relation(fields: [studentId], references: [id], onDelete: Restrict)
  charges             StudentFeeCharge[]
  payments            FeePayment[]
  ledgerEntries       FeeLedgerEntry[]

  @@unique([schoolId, studentId, academicSession])
  @@index([schoolId, academicSession, status])
}

model StudentFeeCharge {
  id                  String                  @id @default(cuid())
  schoolId            String
  studentId           String
  feeAccountId        String
  feeStructureId      String
  feeComponentId      String?
  academicSession     String
  installmentName     String
  dueDate             DateTime
  baseAmountMinor     BigInt
  discountMinor       BigInt                  @default(0)
  scholarshipMinor    BigInt                  @default(0)
  lateFeeMinor        BigInt                  @default(0)
  paidMinor           BigInt                  @default(0)
  refundedMinor       BigInt                  @default(0)
  status              FeeChargeStatus         @default(UPCOMING)
  calculationSnapshot Json?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  school              School                  @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  student             Student                 @relation(fields: [studentId], references: [id], onDelete: Restrict)
  feeAccount          StudentFeeAccount       @relation(fields: [feeAccountId], references: [id], onDelete: Restrict)
  feeStructure        FeeStructure            @relation(fields: [feeStructureId], references: [id], onDelete: Restrict)
  feeComponent        FeeComponent?           @relation(fields: [feeComponentId], references: [id], onDelete: Restrict)
  allocations         FeePaymentAllocation[]
  scholarships        StudentFeeScholarship[]

  @@unique([schoolId, studentId, feeStructureId, feeComponentId, academicSession, installmentName])
  @@index([schoolId, studentId, academicSession])
  @@index([schoolId, dueDate, status])
}

model FeePayment {
  id                   String                 @id @default(cuid())
  schoolId             String
  studentId            String
  feeAccountId         String
  academicSession      String
  idempotencyKey       String
  paymentNumber        String
  amountMinor          BigInt
  unappliedMinor       BigInt                 @default(0)
  method               FeePaymentMethod
  status               FeePaymentStatus       @default(COMPLETED)
  paymentDate          DateTime
  bankName             String?
  instrumentNumber     String?
  instrumentDate       DateTime?
  transactionReference String?
  remarks              String?
  collectedById        String?
  collectionCounter    String?
  metadata             Json?
  reversedPaymentId    String?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  school               School                 @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  student              Student                @relation(fields: [studentId], references: [id], onDelete: Restrict)
  feeAccount           StudentFeeAccount      @relation(fields: [feeAccountId], references: [id], onDelete: Restrict)
  allocations          FeePaymentAllocation[]
  receipt              FeeReceipt?

  @@unique([schoolId, idempotencyKey])
  @@unique([schoolId, paymentNumber])
  @@index([schoolId, paymentDate, status])
  @@index([schoolId, studentId])
}

model FeePaymentAllocation {
  id          String           @id @default(cuid())
  schoolId    String
  paymentId   String
  chargeId    String
  amountMinor BigInt
  createdAt   DateTime         @default(now())
  payment     FeePayment       @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  charge      StudentFeeCharge @relation(fields: [chargeId], references: [id], onDelete: Restrict)

  @@unique([paymentId, chargeId])
  @@index([schoolId, chargeId])
}

model FeeReceipt {
  id               String           @id @default(cuid())
  schoolId         String
  academicSession  String
  paymentId        String           @unique
  receiptNumber    String
  verificationCode String           @unique
  status           FeeReceiptStatus @default(VALID)
  printCount       Int              @default(0)
  lastPrintedAt    DateTime?
  pdfPath          String?
  snapshot         Json
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  school           School           @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  payment          FeePayment       @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@unique([schoolId, academicSession, receiptNumber])
  @@index([schoolId, status, createdAt])
}

model FeeLedgerEntry {
  id              String             @id @default(cuid())
  schoolId        String
  studentId       String
  feeAccountId    String
  academicSession String
  entryType       FeeLedgerEntryType
  referenceType   String
  referenceId     String
  referenceNumber String?
  description     String
  debitMinor      BigInt             @default(0)
  creditMinor     BigInt             @default(0)
  balanceMinor    BigInt
  createdById     String?
  createdAt       DateTime           @default(now())
  school          School             @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  student         Student            @relation(fields: [studentId], references: [id], onDelete: Restrict)
  feeAccount      StudentFeeAccount  @relation(fields: [feeAccountId], references: [id], onDelete: Restrict)

  @@unique([schoolId, referenceType, referenceId, entryType])
  @@index([schoolId, studentId, createdAt])
}

model FeeAdjustment {
  id              String            @id @default(cuid())
  schoolId        String
  studentId       String
  academicSession String
  type            FeeAdjustmentType
  amountMinor     BigInt
  status          FeeApprovalStatus @default(PENDING)
  reason          String
