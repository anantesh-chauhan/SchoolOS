}

model CommunicationAudit {
  id         String   @id @default(cuid())
  schoolId   String?
  actorKey   String?
  action     String
  entityType String
  entityId   String?
  previous   Json?
  current    Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([schoolId, createdAt])
  @@index([schoolId, entityType, entityId])
}

// Fee and financial management. Monetary values are stored in minor units.
model FeeModuleSetting {
  id                      String           @id @default(cuid())
  schoolId                String           @unique
  enabled                 Boolean          @default(false)
  mode                    FeeStructureMode @default(SIMPLE)
  currencyCode            String           @default("INR")
  currencySymbol          String           @default("₹")
  locale                  String           @default("en-IN")
  decimalPrecision        Int              @default(2)
  financialYearStartMonth Int              @default(4)
  dateFormat              String           @default("dd/MM/yyyy")
  receiptFormat           String           @default("{SCHOOL}/{SESSION}/FEE/{SEQ}")
  nextReceiptSequence     Int              @default(1)
  approvalThresholdMinor  BigInt           @default(50000)
  allowPlatformSummary    Boolean          @default(false)
  gatewayEnabled          Boolean          @default(false)
  createdById             String?
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt
  school                  School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
}

model FeeStructure {
  id              String             @id @default(cuid())
  schoolId        String
  academicSession String
  name            String
  code            String
  description     String?
  mode            FeeStructureMode
  version         Int                @default(1)
  status          FeeStructureStatus @default(DRAFT)
  effectiveFrom   DateTime?
  effectiveTo     DateTime?
  publishedAt     DateTime?
  createdById     String?
  approvedById    String?
  changeReason    String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  school          School             @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  components      FeeComponent[]
  assignments     FeeAssignment[]
  charges         StudentFeeCharge[]

  @@unique([schoolId, academicSession, code, version])
  @@index([schoolId, academicSession, status])
}

model FeeComponent {
  id              String             @id @default(cuid())
  schoolId        String
  feeStructureId  String?
  categoryId      String?
  academicSession String?
  name            String
  code            String
  description     String?
  feeType         String?
  amountMinor     BigInt             @default(0)
  frequency       FeeFrequency       @default(ONE_TIME)
  dueDay          Int?
  gracePeriodDays Int                @default(0)
  lateFeeRule     Json?
  taxable         Boolean            @default(false)
  refundable      Boolean            @default(false)
  mandatory       Boolean            @default(true)
  displayOrder    Int                @default(0)
  active          Boolean            @default(true)
  effectiveFrom   DateTime?
  effectiveTo     DateTime?
  applicability   Json?
  createdById     String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  school          School             @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  feeStructure    FeeStructure?      @relation(fields: [feeStructureId], references: [id], onDelete: Restrict)
  category        FeeCategory?       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  charges         StudentFeeCharge[]

  @@unique([schoolId, feeStructureId, code])
  @@index([schoolId, academicSession, active])
  @@index([schoolId, categoryId, active])
}

model FeeCategory {
  id           String         @id @default(cuid())
  schoolId     String
  name         String
  code         String
  description  String?
  displayOrder Int            @default(0)
  active       Boolean        @default(true)
  createdById  String?
  updatedById  String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  school       School         @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  components   FeeComponent[]

  @@unique([schoolId, code])
  @@index([schoolId, active, displayOrder])
}

model FeeAssignment {
  id              String              @id @default(cuid())
  schoolId        String
  academicSession String
  feeStructureId  String
  studentId       String?
  targetType      FeeAssignmentTarget
  targetValue     String?
  priority        Int
  active          Boolean             @default(true)
  effectiveFrom   DateTime?
  effectiveTo     DateTime?
  createdById     String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  school          School              @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  feeStructure    FeeStructure        @relation(fields: [feeStructureId], references: [id], onDelete: Restrict)
  student         Student?            @relation(fields: [studentId], references: [id], onDelete: Restrict)

  @@index([schoolId, academicSession, targetType, targetValue])
  @@index([schoolId, studentId, active])
}

model StudentFeeAccount {
  id                  String             @id @default(cuid())
  schoolId            String
  studentId           String
  academicSession     String
  status              FeeAccountStatus   @default(ACTIVE)
  advanceBalanceMinor BigInt             @default(0)
  carriedForwardMinor BigInt             @default(0)
  lockedAt            DateTime?
