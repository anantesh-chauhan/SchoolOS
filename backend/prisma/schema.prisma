// School-wide employment records. Teaching employees can link to the existing
// Teacher model without duplicating academic assignments.
model Employee {
  id                String                     @id @default(cuid())
  schoolId          String
  userId            String?
  teacherId         String?                    @unique
  employeeId        String
  firstName         String
  lastName          String?
  gender            String?
  dateOfBirth       DateTime?
  bloodGroup        String?
  mobile            String
  email             String?
  aadhaarMasked     String?
  panMasked         String?
  address           String?
  department        String
  designation       String
  category          EmployeeCategory
  employmentType    EmploymentType             @default(PERMANENT)
  status            EmploymentStatus           @default(ACTIVE)
  joiningDate       DateTime
  exitDate          DateTime?
  bankName          String?
  bankAccountMasked String?
  ifsc              String?
  emergencyContact  Json?
  qualifications    Json?
  experience        Json?
  profileImageUrl   String?
  metadata          Json?
  deletedAt         DateTime?
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt
  school            School                     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  teacher           Teacher?                   @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  documents         EmployeeDocument[]
  salaryRevisions   EmployeeSalaryRevision[]
  attendances       EmployeeAttendance[]
  leaveApplications EmployeeLeaveApplication[]
  leaveBalances     EmployeeLeaveBalance[]
  payrolls          EmployeePayroll[]

  @@unique([schoolId, employeeId])
  @@index([schoolId, status, deletedAt])
  @@index([schoolId, department, designation])
  @@index([schoolId, category])
  @@index([schoolId, mobile])
  @@index([userId])
}

